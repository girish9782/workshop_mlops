# Copy this file to .env and paste your real values
GROQ_API_KEY=paste_your_groq_key_here
SESSION_SECRET=any-long-random-string

# Signs the identity tokens the MCP servers verify. Falls back to SESSION_SECRET.
MCP_SECRET=another-long-random-string
# Max assistant messages per user per minute
ASSISTANT_RATE_LIMIT=15

# Super user: ONLY a password. Anyone who signs up (or logs in) with ANY email and exactly this
# password gets the super_user role. Everyone else is a patient. Leave empty to disable.
# Password must be 8+ characters. Keep .env out of git; use a strong password.
SUPERUSER_PASSWORD=change-this-strong-password
